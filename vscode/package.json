{
  "name": "cube-vscode",
  "displayName": "Cube Language Support",
  "description": "Syntax highlighting and diagnostics for the Cube proof assistant",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "cube",
        "aliases": [
          "Cube",
          "cube"
        ],
        "extensions": [
          ".cube"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cube",
        "scopeName": "source.cube",
        "path": "./syntaxes/cube.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Cube Configuration",
      "properties": {
        "cube.executablePath": {
          "type": "string",
          "default": "cube",
          "description": "Path to the Cube compiler binary (assumes global PATH if left default)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/vscode": "^1.125.0",
    "typescript": "^6.0.3"
  }
}
