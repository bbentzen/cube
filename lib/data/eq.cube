import ../core/function.cube

universe k

/* The equality type (not to be confused with path type) is never used */

inductive eq (A : type k) (a : A) : A → type k :=
| r : eq A a a

abbrev J {A : type k} {a : A} {C : Π (x : A), eq A a x → type k} :
  C a (r A a ) → Π (x : A ) (p : eq A a x), C x p :=
λ c x, eqrec A a _ c x

lemma id_to_path {A : type k} {a b : A} : 
  eq A a b → path A a b :=
λ p, J (<i> a) b p

lemma not_id_to_not_path {A : type k} {a b : A} : 
  ¬ path A a b → ¬ eq A a b :=
contrap id_to_path