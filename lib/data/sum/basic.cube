import ../../core/function.cube

universe l k

/* Sum type former, constructors and eliminator */

inductive sum (A B : type l) : type l :=
| inl : A → sum A B
| inr : B → sum A B

def case {A B : type l} {C : A + B → type k} (v : A + B) (cl : Π (x : A) C (inl A B x)) (cr : Π (x : B) C (inr A B x)) :
  C v :=
sumrec _ _ _ cl cr v

def sum_type {A : type l} {B : type k} :
  type (max l k) :=
A + B