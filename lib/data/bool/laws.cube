import ../unit.cube 
import ./basic.cube

universe l

/* Boolean equations */

def bool_neq  :
  ¬ path bool true false :=
λ p, coe i0 i1 (λ i, if (p @ i) unit void) ()

def bool_neq' :
  ¬ path bool false true :=
λ p, coe i1 i0 (λ i, if (p @ i) unit void) ()
 
def bneg_inv (b : bool) :
  path bool (bneg (bneg b)) b :=
if b (<i> true) (<i> false)

def band_comm (b b' : bool) :
  path bool (band b b') (band b' b) :=
if b (if b' (<_> true) (<_> false)) (if b' (<_> false) (<_> false))
 
def band_assoc (b b' b'' : bool) :
  path bool (band b (band b' b'')) (band (band b b') b'') :=
if b 
  (if b' (if b'' (<_> true) (<_> false)) (if b'' (<_> false) (<_> false))) 
  (if b' (if b'' (<_> false) (<_> false)) (if b'' (<_> false) (<_> false)))
 
def bor_comm (b b' : bool) :
  path bool (bor b b') (bor b' b) :=
if b (if b' (<_> true) (<_> true)) (if b' (<_> true) (<_> false))
 
def bor_assoc (b b' b'' : bool) :
  path bool (bor b (bor b' b'')) (bor (bor b b') b'') :=
if b 
  (if b' (if b'' (<_> true) (<_> true)) (if b'' (<_> true) (<_> true))) 
  (if b' (if b'' (<_> true) (<_> true)) (if b'' (<_> true) (<_> false)))

def band_distr (b b' b'' : bool) :
  path bool (band b (bor b' b'')) (bor (band b b') (band b b'')) :=
if b (if b' (if b'' (<_> true) (<_> true)) (if b'' (<_> true) (<_> false)))
  (if b' (if b'' (<_> false) (<_> false)) (if b'' (<_> false) (<_> false)))

def bor_distr (b b' b'' : bool) :
  path bool (bor b (band b' b'')) (band (bor b b') (bor b b'')) :=
if b (if b' (if b'' (<_> true) (<_> true)) (if b'' (<_> true) (<_> true)))
  (if b' (if b'' (<_> true) (<_> false)) (if b'' (<_> false) (<_> false)))