universe k

/* Sigma type former, constructors and eliminator */

inductive sigma (A : type k) (B : A → type k) : type k :=
| pair : Π (x : A), B x → sigma A B

/* Σ (x : A), B x and (x, y) are syntactic sugar for sigma A B and pair _ _ x y */

def pairing {A : type k} {B : A → type k} :
  Π (x : A) (y : B x), Σ (x : A), B x :=
λ x, λ y, (x, y)

/* Sigma type projections and eliminator (as abbreviations) */

abbrev fst {A : type k} {B : A → type k} :
  (Σ (x : A), B x) → A :=
λ w, sigmarec _ _ _ (λ x _, x) w

abbrev snd {A : type k} {B : A → type k} :
  Π (w : Σ (x : A), B x), B (fst w) :=
λ w, sigmarec _ _ _ (λ _ y, y) w

abbrev spread {A : type k} {B : A → type k} {C : (Σ (x : A), B x) → type k} :
  Π (w : Σ (x : A), B x) (c : Π (x : A) (y : B x), C (x, y)), C w :=
λ w c, sigmarec _ _ _ c w

/* Type formation (the product type is defined as sigma A (λ x, B)) */

universe l

def sigma_form {A : type k} {B : A → type l} :
  type (max k l) :=
Σ (x : A), B x

def prod_type {A B : type k} :
  type k :=
A × B