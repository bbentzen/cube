import ./lemmas.cube

universe l 

/* Paths over products */

def prod_eta (A B : type l) (w : A × B) :
  path (A × B) w (fst A (λ _, B) w, snd A (λ _, B) w) :=
sigmarec A (λ _, B) _ (λ x y, <_> (x, y)) w

def pair_iff_eq {A B : type l} {a a' : A} {b b' : B} :
  path (A × B) (a, b) (a', b') ↔ path A a a' × path B b b' :=
(λ p, (<i> fst A (λ _, B) (p @ i), <j> snd A (λ _, B) (p @ j)),
 λ w, <i> ((fst (path A a a') (λ _, path B b b') w) @ i, (snd (path A a a') (λ _, path B b b') w) @ i))

/* def pair_to_eq {A B : type l} {a a' : A} {b b' : B} :
  path (A × B) (a, b) (a', b') → path A a a' × path B b b' :=
fst (path (A × B) (a, b) (a', b')) (λ _, path A a a' × path B b b') pair_iff_eq

def eq_to_pair {A B : type l} {a a' : A} {b b' : B} :
  path A a a' × path B b b' → path (A × B) (a, b) (a', b') :=
snd (path (A × B) (a, b) (a', b')) (λ _, path A a a' × path B b b') pair_iff_eq */

