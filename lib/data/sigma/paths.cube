def eq_to_pair {A B : type ℓ} {a a' : A} {b b' : B} :
  path A a a' × path B b b' → path (A × B) (a, b) (a', b') :=
snd (path (A × B) (a, b) (a', b')) (λ _, path A a a' × path B b b') pair_iff_eq */

