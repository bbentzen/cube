    | i0 → (λ j, q @ j) 
    | i1 → λ j, r @ j) i) 
    ((hcom i0 i1 (λ i, fst A (λ _, B) (p @ i)) 
      | i0 → (λ j, fst A (λ _, B) (q @ j)) 
      | i1 → (λ j, fst A (λ _, B) (r @ j))) i, 
     (hcom i0 i1 (λ i, snd A (λ _, B) (p @ i)) 
      | i0 → (λ j, snd A (λ _, B) (q @ j)) 
      | i1 → (λ j, snd A (λ _, B) (r @ j))) i) :=
