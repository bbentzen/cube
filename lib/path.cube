import ./connection.cube
import ./function.cube

universe l 

/* Path introduction and elimination */

def pathd_abs {A : I → type l} (p : Π (i : I) A i)
⊢ pathd A (p i0) (p i1) :=
<i> p i
 
def pathd_app {A : I → type l} (a : A i0) (b : A i1) (p : pathd A a b)
⊢ Π (i : I) A i :=
λ i, p @ i
 
/* Reflexivity, symmetry and transitivity */
 
def path_rfl {A : type l} {a : A} 
⊢ path A a a :=
<_> _
 
def path_symm {A : type l} {a b : A} (p : path A a b)
⊢ path A b a := 
<k> (hcom (λ i, a)
 | i0 → λ j, p @ j
 | i1 → λ _, a) k
 
def path_trans {A : type l} {a b c : A} (p : path A a b) (q : path A b c)
⊢ path A a c := 
<k> (hcom (λ i, p @ i) 
 | i0 → λ _, a 
 | i1 → λ j, q @ j) k
 
/** Path induction **/

def path_subst {A : type l} (C : A → type l) {a b : A} (p : path A a b) (c : C a)
⊢ C b :=
coe i0 i1 (λ i, C (p @ i)) c

def path_subst' {A : type l} {C : A → type l} {a b : A} (p : path A a b) (c : C b)
⊢ C a :=
coe i1 i0 (λ i, C (p @ i)) c
 
def pathrec {A : type l} {a : A} (C : Π (x : A) (path A a x → type l)) {b : A} (p : path A a b) (c : C a (<_> a)) 
⊢ C b p := 
coe i0 i1 (λ i, C (p @ i) (meet p @ i)) c
 
/** Regularity **/
 
def coe_boundary {C : I → type l} (i : I) (c : C i) 
⊢ path (C i) (coe i i C c) c :=
<_> c
 
def coe_regularity {A : type l} (i j : I) (a : A) 
⊢ path A (coe i j (λ _, A) a) a :=
<_> a
 
def hcom_regularity {A : type l} {a b : A} (p : path A a b)
⊢ path (path A a b) 
  p 
  (<k> (hcom (λ i, p @ i)
   | i0 → λ j, a 
   | i1 → λ j, b 
  ) k) := 
<_> p

/** Boundary separation Proof irrevelance **/

def irrel_uip {A : type l} {a b : A} (p q : path A a b)
⊢ path (path A a b) p q :=
<_> _
 
def irrel_line {A : type l} {a b : A} (p q : path A a b)
⊢ path (Π (x : I) A) (λ i, p @ i) (λ j, q @ j) :=
<_> (λ i, p @ i)
 
def irrel_k {A : type l} {a : A} (p : path A a a)
⊢ path (path A a a) p (<_> a) :=
<_> _
 
def irrel_example {A : type l} {a b : A} {B : path A a b → (Π (x : I) A) → type l} (p q : path A a b) 
⊢ B p (λ i, p @ i) → B q (λ j, q @ j) :=
id
 
def irrel_example2 {A : type l} (i j : I) {a b : A} (p q : I → path A a b)
⊢ path (path A a b) (p i) (q j) :=
<_> _ i

def path_bs {A : type 1} {a b : A} (p q : path A a b) {C : path A a b → type 1} 
⊢ C p ↔ C q := 
id_iff_id
 
/** Strict groupoid structure **/
 
def path_trans_lc {A : type l} {a b : A} (p : path A a b) 
⊢ path (path A a a) (p · p⁻¹) (<_> a) := 
<_> <_> a
 
def path_trans_rc {A : type l} {a b : A} (p : path A a b) 
⊢ path (path A b b) (p⁻¹ · p) (<_> b) := 
<_> <_> b
 
def path_trans_lu {A : type l} {a b : A} (p : path A a b) 
⊢ path (path A a b) p ((<_> a) · p) := 
<_> _
 
def path_trans_ru {A : type l} {a b : A} (p : path A a b) 
⊢ path (path A a b) p (p · <_> b) := 
<_> _
 
def path_symm_inv {A : type l} {a b : A} (p : path A a b)
⊢ path (path A a b) p (p ⁻¹⁻¹) := 
<_> _

def path_trans_assoc {A : type l} {a b c d : A} (p : path A a b) (q : path A b c) (r : path A c d)
⊢ path (path A a d) (p · q · r) ((p · q) · r) := 
<_> p · q · r

/* Other lemmas */

def path_eq_i0 {A : type l} {a b c : A} (p : path A a b)
⊢ path A a c → path A b c :=
λ q, coe i0 i1 (λ i, path A (p @ i) c) q

def path_eq_i1 {A : type l} {a b c : A} (p : path A a b)
⊢ path A c a → path A c b :=
λ q, coe i0 i1 (λ i, path A c (p @ i)) q