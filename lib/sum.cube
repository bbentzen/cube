import ./function.cube

universe l k

/* Sum type former, constructors and eliminator */

inductive sum (A B : type l) ⊢ type l :=
| inl : A → sum A B
| inr : B → sum A B

def case {A B : type l} {C : A + B → type k} (v : A + B) (cl : Π (x : A) C (inl A B x)) (cr : Π (x : B) C (inr A B x))
⊢ C v :=
sumrec _ _ _ cl cr v


/* Sum type */
 
def de_morgan_prod_1 {A B : type l}
⊢ (A × B) → ¬ (¬A + ¬B) :=
λ w v, sumrec (¬A) (¬B) _ (λ f, f (fst w)) (λ g, g (snd w)) v
 
def de_morgan_prod_2 {A B : type l}
⊢  (¬ A × ¬ B) → ¬ (A + B) :=
λ w v, sumrec A B _ (λ x, (fst w) x) (λ y, (snd w) y) v
 
def prod_elim_sum {A B D : type l}
⊢  (A × B) → ((A → D) + (B → D)) → D :=
λ w v, sumrec (A → D) (B → D) _ (λ f, f (fst w)) (λ g, g (snd w)) v
 
def weak_1 {A B : type l}
⊢ A → A + B :=
λ x, inl A B x
 
def weak_2 {A B : type l}
⊢ B → A + B :=
λ y, inr A B y
 
def sum_swap {A B : type l} 
⊢ (A + B) → (B + A) :=
λ v, sumrec A B _ (λ x, inr B A x) (λ y, inl B A y) v

def sum_assoc {A B D : type l}
⊢ (A + (B + D)) ↔ ((A + B) + D) :=
(λ v, sumrec A (B + D) _ (λ x, inl (A + B) D (inl A B x)) (λ v', sumrec B D _ (λ y, inl (A + B) D (inr A B y)) (λ z, inr (A + B) D z) v') v,
 λ v, sumrec (A + B) D _ (λ v', sumrec A B _ (λ x, inl A (B + D) x) (λ y, inr A (B + D) (inl B D y)) v') (λ z, inr A (B + D) (inr B D z)) v)
 
def sum_distrib_1 {A B D : type l} 
⊢ ((A + B) → D) → ((A → D) + (B → D)) :=
λ f, inl (A → D) (B → D) (λ x, f (inl A B x))
 
def sum_distrib_2 {A B D : type l} 
⊢ ((A + B) → D) → ((A → D) + (B → D)) :=
λ f, inr (A → D) (B → D) (λ y, f (inr A B y))
 
def disj_syll_1 {A B D : type l} 
⊢ (A + B) → (¬A) → B  :=
λ v f, sumrec _ _ _ (λ x, abort (f x)) (λ y, y) v
 
def disj_syll_2 {A B : type l}
⊢ (A + B) → (¬B) → A  :=
λ v g, sumrec _ _ _ (λ x, x) (λ y, abort (g y)) v
 
def not_not_lem {A : type l}
⊢ ¬¬ (A + ¬A) :=
λ f, f (inr A (¬A) (λ x, f (inl A (¬A) x)))
 
def lem_implies_dne {A : type l} (v : A + ¬A)
⊢ ¬¬A → A :=
λ f, sumrec _ (¬A) _ id (λ nx, abort (f nx)) v
 
def dne_implies_lem {A : type l} (dne : ¬¬(A + ¬A) → (A + ¬A))
⊢ A + ¬A :=
dne (λ f, f (inr _ (¬A) (λ x, f (inl _ (¬A) x))))
 
def sum_up_1 {A B D : type l}
⊢ (A → D) → (B → D) → ((A + B) → D) :=
λ f g v, sumrec _ _ _ f g v
 
def sum_up_2 {A B D : type l}
⊢ ((A + B) → D) → (A → D) :=
λ f x, f (inl _ _ x)
 
def sum_up_3 {A B D : type l}
⊢ ((A + B) → D) → (B → D) :=
λ f y, f (inr _ _ y) 
 
def sum_to_fun {A B : type l}
⊢ (A + B) → (¬ A → B) :=
λ v, sumrec A B _  (λ x, (λ f, abort (f x))) (λ y f, y) v
 
def sum_neg_to_fun {A B : type l}
⊢ (¬ A + B) → (A → B) :=
λ v x, sumrec (¬ A) _ _ (λ nx, abort (nx x)) (λ y, y) v
 
def de_morgan_sum_1 {A B : type l}
⊢ (A + B) → ¬ (¬ A × ¬ B) :=
λ v w, sumrec _ _ _ (λ x, (fst w) x) (λ y, (snd w) y) v
 
def de_morgan_sum_2 {A B : type l}
⊢ ¬(A + B) → (¬A × ¬B) :=
λ f, (λ x, f (inl A B x) , λ y, f (inr A B y))
 
def de_morgan_sum_3 {A B : type l}
⊢ (¬ A + ¬ B) → (¬ (A × B)) :=
λ v w, sumrec (¬A) (¬B) _ (λ f, f (fst w)) (λ g, g (snd w)) v
 
def sum_elim {A B D : type l}
⊢ (A + B) → ((A → D) × (B → D)) → D :=
λ v f, sumrec _ _ _ (λ x, (fst f) x) (λ y, (snd f) y) v

/* Sum equations TBD */

def sum_eq_inl {A B : type l} {a a' : A}
⊢ path (A + B) (inl A B a) (inl A B a') → path A a a' :=
λ p, <i> sumrec A B _ id (λ _, a) (p @ i)

def sum_eq_inr {A B : type l} {b b' : B}
⊢ path (A + B) inr b inr b' → path B b b' :=
λ p, <i> case (p @ i) (λ _, b) id
 
def sum_neq {A B : type l} {a : A} {b : B}
⊢ ¬ path (A + B) (inl a) (inr b) :=
λ p, coe i0 i1 (λ i, case (p @ i) (λ _, unit) (λ _, void)) ()

def sum_neq' {A B : type l} {a : A} {b : B}
⊢ ¬ path (A + B) (inr b) (inl a) :=
λ p, coe i1 i0 (λ i, case (p @ i) (λ _, unit) (λ _, void)) ()

def sum_code (A B : type l) (v v' : A + B)
⊢ type l :=
case v (λ x, case v' (λ x', path (A + B) (inl x) (inl x')) (λ _, void)) (λ y, case v' (λ _, void) (λ y', path (A + B) (inr y) (inr y')))
 
def sum_eq {A B : type l} (v v' : A + B)
⊢ path (A + B) v v' ↔ sum_code A B v v' :=
case v 
  (λ y, case v' 
    (λ y', id_iff_id) (λ y', (sum_neq, absurd))) 
  (λ y, case v' (λ y', (sum_neq', absurd)) (λ x', id_iff_id))

/* Product */

def sigma_sum_distrb {A B : type l} {C : A → type l}
⊢ (Σ (x : A) B + C x) → (B + Σ (x : A) C x) :=
λ w, case (snd w) (λ x, inl x) (λ y, inr (fst w, y))

/* Function type */

theorem pi_sum_distr {A : type l} {B D : A → type l}
⊢ ((Π (x : A) B x) + (Π (x : A) D x)) → (Π (x : A) B x + D x) :=
λ w x, case w (λ f, inl (f x)) (λ g, inr (g x))
 
theorem pi_sum_distrb {A B : type l} {D : A → type l}
⊢ (B + (Π (x : A) D x)) → (Π (x : A) B + D x) :=
λ w x, case w (λ y, inl y) (λ f, inr (f x))
 
theorem dcase {A B : type l} {D : (A + B) → type l} (f : Π (x : A) D (inl x)) (g : Π (y : B) D (inr y))
⊢ Π (x : A + B) D x :=
λ v, case v f g

/* The unit type */

def lem_unit
⊢ unit + ¬unit :=
inl unit (¬unit) ()

/* Interaction with units */

def unit_to_bool
⊢ (unit + unit) → bool :=
λ v, case v (λ u, let u true) (λ u, let u false)
 
theorem bool_to_unit
⊢ bool → (unit + unit) :=
λ b, if b (inl ()) (inr ())