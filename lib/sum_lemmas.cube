import ./sum.cube
import ./unit.cube
import ./bool.cube

universe l k

/* Lemmas about sum types */

def sum_eq_inl {A B : type l} {a a' : A} :
  path (A + B) (inl A B a) (inl A B a') → path A a a' :=
λ p, <i> sumrec A B _ id (λ _, a) (p @ i)

def sum_eq_inr {A B : type l} {b b' : B} :
  path (A + B) (inr A B b) (inr A B b') → path B b b' :=
λ p, <i> sumrec A B _ (λ _, b) id (p @ i)
 
def sum_neq {A B : type l} {a : A} {b : B} :
  ¬ path (A + B) (inl A B a) (inr A B b) :=
λ p, coe i0 i1 (λ i, sumrec A B (λ _, type 0) (λ _, unit) (λ _, void) (p @ i)) ()

def sum_neq' {A B : type l} {a : A} {b : B} :
  ¬ path (A + B) (inr A B b) (inl A B a) :=
λ p, coe i1 i0 (λ i, sumrec A B _ (λ _, unit) (λ _, void) (p @ i)) ()

def sum_code (A B : type l) (v v' : A + B) :
  type l :=
sumrec A B _ (λ x, sumrec A B _ (λ x', path (A + B) (inl A B x) (inl A B x')) (λ _, void) v') 
(λ y, sumrec A B _ (λ _, void) (λ y', path (A + B) (inr A B y) (inr A B y')) v') v

def sum_eq {A B : type l} (v v' : A + B) :
  path (A + B) v v' ↔ sum_code A B v v' :=
sumrec A B _  
  (λ y, sumrec A B _  (λ y', id_iff_id) (λ y', (sum_neq, absurd)) v') 
  (λ y, sumrec A B _ (λ y', (sum_neq', absurd)) (λ x', id_iff_id) v') v

/* Product */

def sigma_sum_distrb {A B : type l} {D : A → type l} :
  (Σ (x : A) B + D x) → (B + Σ (x : A) D x) :=
λ w, sumrec B (D (fst w)) _ (λ x, inl B (Σ (x : A) D x) x) (λ y, inr B (Σ (x : A) D x) (fst w, y)) (snd w)

/* Function type */

theorem pi_sum_distr {A : type l} {B D : A → type l} :
  ((Π (x : A) B x) + (Π (x : A) D x)) → (Π (x : A) B x + D x) :=
λ w x, sumrec (Π (x : A) B x) (Π (x : A) D x) _ (λ f, inl (B x) (D x) (f x)) (λ g, inr (B x) (D x) (g x)) w

theorem pi_sum_distrb {A B : type l} {D : A → type l} :
  (B + (Π (x : A) D x)) → (Π (x : A) B + D x) :=
λ w x, sumrec B (Π (x : A) D x) _ (λ y, inl B (D x) y) (λ f, inr B (D x) (f x)) w

/* The unit type */

def lem_unit :
  unit + ¬unit :=
inl unit (¬unit) ()

/* Interaction with units */

def unit_to_bool :
  (unit + unit) → bool :=
λ v, sumrec unit unit _ (λ u, let u true) (λ u, let u false) v
 
theorem bool_to_unit :
  bool → (unit + unit) :=
λ b, if b (inl unit unit ()) (inr unit unit ())