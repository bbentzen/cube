import ../core/function.cube

universe k

/* Basic algebraic notions */

def is_associative {A : type k} (op : A → A → A) : type k :=
  Π (x y z : A), path A (op (op x y) z) (op x (op y z))

def has_right_identity {A : type k} (op : A → A → A) : type k :=
  Σ (y x : A), path A (op x y) y

def has_left_identity {A : type k} (op : A → A → A) : type k :=
  Σ (y : A), Π (x : A), path A (op y x) x

def has_identity {A : type k} (op : A → A → A) : type k :=
  has_right_identity op × has_left_identity op

def has_inverse {A : type k} (op : A → A → A) (e : A) : type k :=
  Π (x : A), Σ (y : A), path A (op x y) e

def is_commutative {A : type k} (op : A → A → A) : type k :=
  Π (x y : A), path A (op x y) (op y x)


