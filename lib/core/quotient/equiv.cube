universe ℓ

def is_refl {A : type ℓ} (R : A → A → type ℓ) : type ℓ :=
Π (x : A), R x x

def is_symm {A : type ℓ} (R : A → A → type ℓ) : type ℓ :=
Π (x y : A), R x y → R y x

def is_trans {A : type ℓ} (R : A → A → type ℓ) : type ℓ :=
Π (x y z : A), R x y → R y z → R x z

def is_equiv {A : type ℓ} (R : A → A → type ℓ) : type ℓ :=
is_refl R × is_symm R × is_trans R